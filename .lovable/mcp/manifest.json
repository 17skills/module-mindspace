{
  "version": 1,
  "sdk_version": "3.0.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://dxpfeoqceybvkbdynqdv.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "canvas-spark",
      "version": "0.1.0",
      "title": "scopebuilder"
    },
    "tools": [
      {
        "name": "list_boards",
        "title": "Boards auflisten",
        "description": "List the boards of the signed-in user with id, title and description.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_board",
        "title": "Board lesen",
        "description": "Read one board of the signed-in user: its modules (nodes) with type, title and text content, plus the connections between them.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "board_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Board id, as returned by list_boards."
            },
            "max_content_chars": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20000
                },
                {
                  "type": "null"
                }
              ],
              "description": "Truncate each module's text to this many characters. Null means 2000."
            }
          },
          "required": [
            "board_id",
            "max_content_chars"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_zones",
        "title": "Felder auflisten",
        "description": "List the background fields (zones) of one board. Each field bundles the modules lying on it and can be published as its own app.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "board_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Board id, as returned by list_boards."
            }
          },
          "required": [
            "board_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_zone",
        "title": "Feld lesen",
        "description": "Read one background field (zone) as a self-contained bundle: its modules with type, title and text, plus the connections between them.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "zone_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Field id, as returned by list_zones."
            },
            "max_content_chars": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20000
                },
                {
                  "type": "null"
                }
              ],
              "description": "Truncate each module's text to this many characters. Null means 2000."
            }
          },
          "required": [
            "zone_id",
            "max_content_chars"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_content",
        "title": "Inhalte durchsuchen",
        "description": "Search the signed-in user's modules across all boards by title and text, returning matching modules with their board id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200,
              "description": "Search term."
            },
            "board_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Limit the search to one board. Null searches all boards."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum number of results. Null means 20."
            }
          },
          "required": [
            "query",
            "board_id",
            "limit"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "create_note",
        "title": "Notiz anlegen",
        "description": "Add a note module with a title and text to one of the signed-in user's boards.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "board_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Board id, as returned by list_boards."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Short title of the note."
            },
            "content": {
              "type": "string",
              "maxLength": 20000,
              "description": "Body text of the note."
            },
            "position_x": {
              "description": "Canvas x position. Null places it at 0.",
              "type": [
                "number",
                "null"
              ]
            },
            "position_y": {
              "description": "Canvas y position. Null places it at 0.",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "board_id",
            "title",
            "content",
            "position_x",
            "position_y"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
